{
  "name": "batpod-server",
  "version": "1.0.0",
  "private": true,
  "description": "API + CPQ pricing engine for the Batpod Labs shop",
  "main": "api/index.js",
  "scripts": {
    "dev": "npm test --silent && node --watch src/dev.js",
    "seed": "node src/seed.js",
    "test:pricing": "node src/pricing/engine.test.js",
    "test:catalog": "node src/pricing/catalog.test.js",
    "test": "npm run test:pricing && npm run test:catalog && npm run test:estimate",
    "test:estimate": "node src/pricing/customEstimate.test.js",
    "dev:fast": "node --watch src/dev.js",
    "start": "node src/dev.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.9.5"
  }
}
