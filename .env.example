# MongoDB Atlas connection string (free M0 cluster is fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/batpod?retryWrites=true&w=majority

# Shared secret the admin app sends as x-admin-key. Generate a long random one.
ADMIN_KEY=change-me-to-something-long-and-random

# Comma separated. Leave blank in local dev to allow everything.
ALLOWED_ORIGINS=https://batpodlabs.com,https://admin.batpodlabs.com

# Default courier charge in rupees, before any free-shipping rule
DEFAULT_SHIPPING_FEE=60

PORT=4000
