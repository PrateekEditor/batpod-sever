# MongoDB Atlas connection string (free M0 cluster is fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/batpod?retryWrites=true&w=majority

# Shared secret the admin app sends as x-admin-key. Generate a long random one.
ADMIN_KEY=change-me-to-something-long-and-random

# Comma separated. Leave blank in local dev to allow everything.
ALLOWED_ORIGINS=https://batpodlabs.com,https://admin.batpodlabs.com

# Default courier charge in rupees, before any free-shipping rule
DEFAULT_SHIPPING_FEE=60

PORT=4000

# --- Custom print estimator -------------------------------------------------
# Markup over cost before the over-estimate buffer
CUSTOM_MARGIN_MULTIPLIER=2.6
# Headroom carried because the file has not been sliced (1.18 = +18%)
CUSTOM_OVER_ESTIMATE=1.18
CUSTOM_SETUP_MINUTES=12
CUSTOM_MAX_FILE_MB=50

# Set true once you have issued partner keys. Leave false while testing, or you
# lock out your own website.
REQUIRE_PARTNER_KEY=false

# --- Costing assumptions (shared by margins, payback and the estimator) ------
COST_FILAMENT_PER_GRAM=1.2
COST_ELECTRICITY_PER_UNIT=9
COST_PRINTER_WATTS=110
COST_FAIL_RATE=0.08
COST_LABOUR_PER_HOUR=250
COST_PACKAGING=10
PRINTER_HOURS_PER_DAY=12

# --- Customer accounts ------------------------------------------------------
# 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out, which is also how you revoke every session.
JWT_SECRET=change-me-to-32-or-more-random-characters
JWT_TTL=7d
